# Canonical origin for metadata, sitemap, and emails.
# Fallback: https://${VERCEL_PROJECT_PRODUCTION_URL}, then http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile. Local/preview fallback: always-pass test keys.
# Production needs both keys or the form shows "temporarily unavailable".
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend. Absent → emails are logged to the server console as [email:dev].
RESEND_API_KEY=
# Default: Flowly <onboarding@resend.dev> (only delivers to the Resend account owner).
RESEND_FROM=
# Required in production for owner notifications.
WAITLIST_NOTIFY_EMAIL=
# true sends the subscriber confirmation. Enable only with a verified domain.
WAITLIST_CONFIRMATION_ENABLED=false

# Upstash Redis REST. Either this pair or the Vercel Marketplace KV_* pair.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Injected by the Vercel Marketplace Upstash integration when UPSTASH_* is absent.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Dashboard data source: mock (default) or shopcore.
DASHBOARD_DATA_SOURCE=mock
# Required when DASHBOARD_DATA_SOURCE=shopcore.
SHOPCORE_API_URL=
SHOPCORE_API_KEY=
# Artificial delay per mock call in milliseconds (try 600 to watch skeletons).
MOCK_LATENCY_MS=0
